[
  {
    "id": "TC001",
    "title": "Smoke: login/bypass de testing navega al dashboard",
    "description": "Verifica el ingreso desde la UI real de login en desarrollo y que el dashboard principal cargue sin depender de navegación mensual.",
    "category": "Dashboard mensual con KPIs y accesos rápidos",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Click Ingresar testing button"
      },
      {
        "type": "assertion",
        "description": "Verify text visible \"Dashboard\""
      },
      {
        "type": "assertion",
        "description": "Verify text visible \"Ventas del Mes\""
      },
      {
        "type": "assertion",
        "description": "Verify text visible \"Productos\""
      }
    ]
  },
