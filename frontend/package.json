{
  "name": "octopustrack-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:tenant",
    "dev:tenant": "vite --config vite.config.ts --host --port 5173 --strictPort --open /tenant.html",
    "dev:admin": "vite --config vite.config.ts --host --port 5174 --strictPort --open /admin.html",
    "dev:landing": "vite --config vite.config.ts --host --port 5175 --strictPort --open /landing.html",
    "build": "tsc && vite build",
    "build:tenant": "tsc && vite build",
    "build:admin": "tsc && vite build",
    "build:landing": "tsc && BUILD_APP=landing vite build --config vite.config.ts --outDir dist-landing --emptyOutDir && cp src/landing/sitemap.xml dist-landing/ && cp src/landing/robots.txt dist-landing/ && cp -r public/images dist-landing/",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.28.4",
    "axios": "^1.6.8",
    "clsx": "^2.1.0",
    "driver.js": "^1.3.6",
    "gsap": "^3.15.0",
    "lucide-react": "^0.359.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.6"
  }
}
