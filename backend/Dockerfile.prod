FROM python:3.11-slim

# v1.0.18 - Add WeasyPrint GTK dependencies
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencies for psycopg and WeasyPrint - using fix-missing
RUN apt-get update && apt-get install -y --fix-missing --no-install-recommends \
    gcc \
    libpq-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN chmod +x /app/docker/entrypoint-secrets.sh

EXPOSE 8000

ENTRYPOINT ["/app/docker/entrypoint-secrets.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
